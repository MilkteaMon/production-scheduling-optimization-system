# Optional: final public origin, without a trailing slash.
VITE_SITE_URL=
# Remains false until the public content is reviewed.
VITE_ALLOW_INDEXING=false

# OpsPilot backend (optional; defaults work without this file)
AI_ENABLED=false
# openai_api uses a Platform key; codex_subscription uses your local ChatGPT Codex login.
AI_PROVIDER=openai_api
OPENAI_API_KEY=
OPENAI_MODEL=
# For local subscription usage: AI_PROVIDER=codex_subscription, OPENAI_MODEL=gpt-6.1-sol.
# CODEX_PATH may point to the official codex executable if it is not on PATH.
CODEX_PATH=
OPENAI_AGENTS_DISABLE_TRACING=true
# Optional external CBC executable; otherwise use a project-local or packaged CBC.
CBC_PATH=
# DATABASE_URL=sqlite:///runtime/opspilot.db
