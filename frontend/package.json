{
  "name": "production-scheduling-optimization-system-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "generate:api": "openapi-typescript ../backend/openapi.json -o src/api/schema.d.ts && prettier --write src/api/schema.d.ts",
    "format": "prettier --write src tests *.ts *.json index.html"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.0",
    "lucide-react": "1.55.0",
    "plotly.js-basic-dist-min": "^3.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-plotly.js": "^2.6.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^24.0.0",
    "@types/plotly.js": "^3.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/react-plotly.js": "^2.6.0",
    "@vitejs/plugin-react": "^6.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "openapi-typescript": "^7.0.0",
    "prettier": "^3.8.3",
    "tailwindcss": "4.3.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.0.0",
    "vite": "8.3.4",
    "vitest": "^4.0.0"
  }
}
